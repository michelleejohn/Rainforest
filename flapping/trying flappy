def draw_intro_screen():
    window.blit(background_image, (0, 0))
    overlay = pygame.Surface((GAME_WIDTH, GAME_HEIGHT), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 170))
    window.blit(overlay, (0, 0))

    box_rect = pygame.Rect(0, GAME_HEIGHT - 160, GAME_WIDTH, 160)
    box_surface = pygame.Surface((box_rect.width, box_rect.height), pygame.SRCALPHA)
    box_surface.fill((255, 255, 255, 180))
    window.blit(box_surface, box_rect.topleft)
    pygame.draw.rect(window, (0, 0, 0), box_rect, 3, border_radius=16)

    text_area = pygame.Rect(
        box_rect.x + fairy_width + 40,
        box_rect.y + 20,
        box_rect.width - fairy_width - 60,
        box_rect.height - 40,
    )

    intro_font = pygame.font.Font('carattere-regular.ttf', 32)

    if message_start_time:
        elapsed = time.time() - message_start_time
        message_index = int(elapsed / 2.0)  # 2 seconds per message
        message_index = min(message_index, len(intro_messages))
    else:
        message_index = 0

    if message_index < len(intro_messages):
        line = intro_messages[message_index]
        line_surf = intro_font.render(line, True, "black")
        line_rect = line_surf.get_rect(center=text_area.center)
        window.blit(line_surf, line_rect)
    else:
        hint_font = pygame.font.Font('carattere-regular.ttf', 26)
        hint_surf = hint_font.render("Press any key or click to start", True, "black")
        hint_rect = hint_surf.get_rect(center=(text_area.centerx, text_area.bottom - 20))
        window.blit(hint_surf, hint_rect)

    window.blit(fairy_image, (20, box_rect.y + 12))


def draw_timer():
    if timer_start_time is None:
        return
    elapsed_time = max(0, int(time.time() - timer_start_time))
    remaining_time = max(0, timer_limit - elapsed_time)
    timer_text = carattere_font.render(f"Time: {remaining_time}s", True, "black")
    timer_rect = pygame.Rect(GAME_WIDTH - 200, 10, 180, 40)
    pygame.draw.rect(window, "white", timer_rect)
    pygame.draw.rect(window, "black", timer_rect, 2)
    text_rect = timer_text.get_rect(center=(timer_rect.centerx, timer_rect.centery))
    window.blit(timer_text, text_rect)


def draw():
    window.blit(background_image, (0,0))
    window.blit(bird.img,bird)

    for pipe in pipes:
        window.blit(pipe.img,pipe)

    text_str = str(int(score))
    if game_over:
        text_str += " Game Over"

    text_font = pygame.font.Font('carattere-regular.ttf', 30) # add carattere
    text_render = text_font.render(text_str, True, "white")
    window.blit(text_render,(5,0))

    draw_timer()



def move():
    global velocity_y, score, game_over
    velocity_y += gravity
    bird.y += velocity_y
    bird.y = max(bird.y,0) #prevents bird from going above top of screen

    if bird.y> GAME_HEIGHT:
        game_over = True
        return

    for pipe in pipes:
        pipe.x += velocity_x

        if not pipe.passed and bird.x> pipe.x + pipe.width: #check if bird has passed pipe
            score += 0.5 
            pipe.passed = True
            #increment score by 0.5 for each pipe passed (top and bottom)

        if bird.colliderect(pipe): #check for collision with pipe
            game_over = True
            return
        
        while len(pipes) > 0 and pipes[0].x <- pipe_width: #
            pipes.pop(0) #remove first pipe in list

def create_pipes():
    random_pipe_y = pipe_y - pipe_height/4 - random.random()* (pipe_height/2) #random y value for top pipe
    opening_space = GAME_HEIGHT/4

    top_pipe= Pipe(top_pipe_image)
    top_pipe.y = random_pipe_y
    pipes.append(top_pipe)

    bottom_pipe = Pipe(bottom_pipe_image)
    bottom_pipe.y = top_pipe.y+ top_pipe.height + opening_space
    pipes.append(bottom_pipe)

    print(len(pipes))
pygame.init()
window = pygame.display.set_mode((GAME_WIDTH,GAME_HEIGHT))
pygame.display.set_caption("Flappy Dove")
clock = pygame.time.Clock()

create_pipes_timer = pygame.USEREVENT + 0 #first event
pygame.time.set_timer(create_pipes_timer,1500) #called every 1.5 seconds

# keeps window open while we run program
while True: #game loop
    if show_intro and message_start_time is None:
        message_start_time = time.time()
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            exit()

        if event.type == create_pipes_timer and not game_over and not show_intro:
            create_pipes()

        if event.type == pygame.KEYDOWN:
            if show_intro:
                show_intro = False
                timer_start_time = time.time()
            elif event.key in (pygame.K_SPACE, pygame.K_x, pygame.K_UP):
                velocity_y = -6 #move up

        if event.type == pygame.MOUSEBUTTONDOWN:
            if show_intro:
                show_intro = False
                timer_start_time = time.time()

    if show_intro:
        draw_intro_screen()
        pygame.display.update()
        clock.tick(60)
        continue

    if not game_over:
        move()
        if timer_start_time:
            elapsed_time = time.time() - timer_start_time
            if elapsed_time >= timer_limit:
                game_over = True
        draw()
        pygame.display.update()
        clock.tick(60) #60 fps