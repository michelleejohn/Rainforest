class Bird(pygame.Rect):
    def __init__(self,img):
        pygame.Rect.__init__(self,bird_x,bird_y,bird_width,bird_height)
        self.img = img
       
# pipe class
pipe_x = GAME_WIDTH
pipe_y = 0
pipe_width = 250
pipe_height = 400

# fairy class 
fairy_x = GAME_WIDTH/2
fairy_y = GAME_HEIGHT/2
fairy_width = 100
fairy_height = 100
class Pipe(pygame.Rect):
    def __init__(self,img):
        pygame.Rect.__init__(self,pipe_x,pipe_y,pipe_width,pipe_height)
        self.img = img
        self.passed = False

top_pipe_image = pygame.image.load("topvine.png")
top_pipe_image = pygame.transform.scale(top_pipe_image,(pipe_width,pipe_height))
bottom_pipe_image = pygame.image.load("bottomstump.png")
bottom_pipe_image = pygame.transform.scale(bottom_pipe_image,(pipe_width,pipe_height))
# game images
background_image = pygame.image.load("flappybg.png")
bird_image = pygame.image.load("dove.png")
bird_image = pygame.transform.scale(bird_image,(bird_width,bird_height))
top_pipe_image = pygame.image.load("topvine.png")
top_pipe_image = pygame.transform.scale(top_pipe_image,(pipe_width,pipe_height))
bottom_pipe_image = pygame.image.load("bottomstump.png")
bottom_pipe_image = pygame.transform.scale(bottom_pipe_image,(pipe_width,pipe_height))
fairy_image = pygame.image.load("purplefairy.png")
fairy_image = pygame.transform.scale(fairy_image,(100,100))

# game logic
bird = Bird(bird_image)
pipes = []
velocity_x = -2 #movement of pipes to the left speed and simulates bird moving right
velocity_y = 0 #movement of bird up and down
gravity = 0.4 #acceleration of bird downwards
score = 0
game_over = False

def draw():
    window.blit(background_image, (0,0))
    pygame.draw.rect(window, (0,0,0), (dialogue_box_x,
                                        dialogue_box_y,
                                        dialogue_box_width,
                                        dialogue_box_height))
    dialogue_text = "Help the dove navigate through the forest!"
    dialogue_font = pygame.font.SysFont("carattere-regular.ttf", 20)
    window.blit(fairy_image, (fairy_x,fairy_y))
    window.blit(bird.img,bird)

    for pipe in pipes:
        window.blit(pipe.img,pipe)

    text_str = str(int(score))
    if game_over:
        text_str += " Game Over"

    text_font = pygame.font.SysFont("carattere-regular.ttf", 30) # add carattere
    text_render = text_font.render(text_str, True, "white")
    window.blit(text_render,(5,0))



def move():
    global velocity_y, score, game_over
    velocity_y += gravity
    bird.y += velocity_y
    bird.y = max(bird.y,0) #prevents bird from going above top of screen

    if bird.y> GAME_HEIGHT:
        game_over = True
        return

    for pipe in pipes:
        pipe.x += velocity_x

        if not pipe.passed and bird.x> pipe.x + pipe.width: #check if bird has passed pipe
            score += 0.5 
            pipe.passed = True
            #increment score by 0.5 for each pipe passed (top and bottom)

        if bird.colliderect(pipe): #check for collision with pipe
            game_over = True
            return
        
        while len(pipes) > 0 and pipes[0].x <- pipe_width: #
            pipes.pop(0) #remove first pipe in list

def create_pipes():
    random_pipe_y = pipe_y - pipe_height/4 - random.random()* (pipe_height/2) #random y value for top pipe
    opening_space = GAME_HEIGHT/4

    top_pipe= Pipe(top_pipe_image)
    top_pipe.y = random_pipe_y
    pipes.append(top_pipe)

    bottom_pipe = Pipe(bottom_pipe_image)
    bottom_pipe.y = top_pipe.y+ top_pipe.height + opening_space
    pipes.append(bottom_pipe)

    print(len(pipes))
pygame.init()
window = pygame.display.set_mode((GAME_WIDTH,GAME_HEIGHT))
pygame.display.set_caption("Flappy Dove")
clock = pygame.time.Clock()

create_pipes_timer = pygame.USEREVENT + 0 #first event
pygame.time.set_timer(create_pipes_timer,1500) #called every 1.5 seconds

# keeps window open while we run program
while True: #game loop
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            exit()

        if event.type == create_pipes_timer and not game_over:
            create_pipes()

        if event.type == pygame.KEYDOWN:
            if event.key in (pygame.K_SPACE, pygame.K_x, pygame.K_UP):
                 velocity_y = -6 #move up

# maybe remove later when pushed to github, this resets the game toplay again
               # if game_over:
                #    bird.y = bird_y
                 #   pipes.clear()
                  #  score = 0
                  #  game_over = False 

    if not game_over:
     move()
     draw()
     pygame.display.update()
